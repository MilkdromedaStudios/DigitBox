*.html filter=lfs diff=lfs merge=lfs -text
# The Eaglercraft launcher pages are committed as plain HTML on purpose: the
# Cloudflare worker serves them straight from raw GitHub, where an LFS pointer
# would break them. Exempt them from the LFS rule above so git stops reporting
# them as modified (and nobody commits pointer stubs by accident).
public/projects/eaglercraft-launcher.html -filter !diff !merge
public/projects/eaglercraft-launcher/*.html -filter !diff !merge
public/projects/eaglercraft-runtime/*.html -filter !diff !merge
