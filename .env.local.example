# GitHub repo that stores content (see docs/GITHUB_RELEASE_ASSETS.md).
# Reads default to MilkdromedaStudios/DigitBox with no configuration; the
# token raises API rate limits and is required for publishing from the admin.
GITHUB_REPO_OWNER=MilkdromedaStudios
GITHUB_REPO_NAME=DigitBox
GITHUB_TOKEN=
# Release tag that holds the game HTML assets (default: game-assets)
GITHUB_ASSETS_TAG=game-assets

# Optional: public URL of the Cloudflare R2 bucket that holds game/post HTML
# files (see docs/CLOUDFLARE_R2_SETUP.md). Example: https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=

# ---- DigitBox Pro / Stripe -------------------------------------------------
# These are runtime values for the Cloudflare Pages deployment. GitHub repo
# secrets are NOT automatically available to the live Pages Functions when the
# project is deployed through Cloudflare's Git integration.
#
# Stripe test/sandbox mode is optional. For direct production use, configure a
# matching live set: sk_live_... + live price_... IDs + the live webhook's
# whsec_.... Never mix resources from different Stripe environments.
# Keep STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create one recurring Stripe Price for $1.99/month and one recurring yearly
# Price at the annual amount you choose, then paste their price_... IDs here.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
DIGITBOX_SITE_URL=https://digitbox.dev

# ---- YouTube videos ------------------------------------------------------
# YouTube Data API v3 key for the Recommended / Videos / Shorts feeds and
# YouTube search (see docs/YOUTUBE_API_SETUP.md). Without it the site shows
# only the DigitBox channel's own videos.
#
# IMPORTANT: read at RUNTIME by the deployed site, so set it in the HOSTING
# env (Cloudflare Pages → Settings → Variables and Secrets, and/or Vercel →
# Settings → Environment Variables), then redeploy. A GitHub repository secret
# is NOT visible to the live site.
YOUTUBE_API_KEY=
# Optional: which country's popular charts everyone sees (two-letter code,
# default US). "auto" gives each visitor their own country's charts instead,
# which costs more quota (each country is cached separately).
# YOUTUBE_REGION=US
